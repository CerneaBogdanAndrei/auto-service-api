# Copy to .env (git-ignored) and adjust for your machine.
# All values below are for LOCAL DEVELOPMENT ONLY.

# REQUIRED: HMAC-SHA256 key used to sign JWTs, at least 32 bytes.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# PostgreSQL
DB_NAME=autoservice
DB_USERNAME=autoservice
DB_PASSWORD=autoservice
DB_PORT=5432

# API
API_PORT=8080
